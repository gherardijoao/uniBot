# Variáveis de ambiente para Docker
# Copie para .env antes de rodar docker-compose

# === Gemini API ===
GOOGLE_API_KEY=sua_chave_do_gemini_aqui

# === ChromaDB ===
CHROMA_DIR=/app/chroma_db

# === Embedding Model ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === SIG (Sistema Integrado de Gestão) ===
SIG_BASE_URL=https://sig.ufla.fr
SIG_USUARIOS_ENDPOINT=/api/usuarios
SIG_DOCUMENTOS_ENDPOINT=/api/documentos
SIG_RESOLUCOES_ENDPOINT=/api/resolucoes
SIG_HORARIOS_ENDPOINT=/api/horarios

# Autenticação SIG (se necessário)
SIG_API_KEY=
SIG_USERNAME=
SIG_PASSWORD=

# === Logging ===
LOG_LEVEL=INFO

# === Debug ===
DEBUG=False
